        "z": "bd5767a10a2ab276",
        "name": "reply /start",
        "func": "// Из входящего сообщения берём chatId\nconst chatId = msg.payload.chatId;\n\n// Формируем ответ для telegram sender\nmsg.payload = {\n    chatId: chatId,\n    type: \"message\",\n    content: \n        \"Привет! Я бот лабораторной работы №2.\\n\" +\n        \"Студент: Dubrovshchik\\n\\n\" +\n        \"Доступные команды:\\n\" +\n        \"/start — показать это сообщение\\n\" +\n        \"/sixseven — секрет)\\n\\n\" +\n        \"Просто напиши любое сообщение — я отвечу эхом.\"\n};\n\nreturn msg;",
