    {
        "id": "f3d9149acee8a1cc",
        "type": "function",
        "z": "bd5767a10a2ab276",
        "name": "function 4",
        "func": "const text = msg.payload.content;\nconst chatId = msg.payload.chatId;\n\n// Если это команда — не эхо\nif (text && text.startsWith(\"/\")) {\n    return null;\n}\n\n// Иначе — эхо\nmsg.payload = {\n    chatId: chatId,\n    type: \"message\",\n    content: \"Ты написал: \" + text\n};\n\nreturn msg;",
