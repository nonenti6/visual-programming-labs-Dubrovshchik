    {
        "id": "e6d799be1c85dd65",
        "type": "function",
        "z": "dd58df26e07fa877",
        "name": "function 3",
        "func": "// Path-параметр\nconst id = msg.req.params.id;\n\n// Query-параметры (после ?)\nconst query = msg.req.query;\n\n// \"База данных\" (в реальности — массив)\nconst items = [\n    { id: 1, name: \"Laptop\",    price: 1200 },\n    { id: 2, name: \"Mouse\",     price: 25 },\n    { id: 3, name: \"Keyboard\",  price: 80 },\n    { id: 4, name: \"Monitor\",   price: 300 }\n];\n\n// Проверяем, что id — число\nconst numericId = Number(id);\nif (!Number.isInteger(numericId) || numericId <= 0) {\n    msg.statusCode = 400;\n    msg.payload = {\n        error: \"Bad Request\",\n        message: \"Параметр id должен быть положительным целым числом\",\n        received: id\n    };\n    return msg;\n}\n\n// Ищем элемент\nconst item = items.find(i => i.id === numericId);\n\nif (!item) {\n    msg.statusCode = 404;\n    msg.payload = {\n        error: \"Not Found\",\n        message: \"Элемент с таким id не найден\",\n        id: numericId\n    };\n    return msg;\n}\n\n// Успех\nmsg.statusCode = 200;\nmsg.payload = {\n    item: item,\n    query: query,\n    requested_at: new Date().toISOString()\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
