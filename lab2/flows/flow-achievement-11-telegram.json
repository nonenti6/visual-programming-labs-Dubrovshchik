    {
        "id": "e34c1c6ba347b1c3",
        "type": "function",
        "z": "cf20182d9e5c27fd",
        "name": "handle callback",
        "func": "// Достаём данные из callback\nconst chatId = msg.payload.chatId;\nconst data   = msg.payload.content;  // здесь лежит строка типа \"order:pizza\"\n\nif (!data) {\n    node.warn(\"Пустой callback_data\");\n    return null;\n}\n\nconst parts = data.split(\":\");  // [\"order\", \"pizza\"] или [\"confirm\", \"yes\", \"pizza\"]\n\nlet content;\nlet keyboard;\n\nif (parts[0] === \"order\") {\n    // Пользователь выбрал блюдо — показываем подтверждение\n    const dish = parts[1];\n    content = \"Вы выбрали: \" + dish + \".\\nПодтверждаете заказ?\";\n    keyboard = {\n        inline_keyboard: [\n            [{ text: \"✅ Да\",  callback_data: \"confirm:yes:\" + dish }],\n            [{ text: \"❌ Нет\", callback_data: \"confirm:no\" }]\n        ]\n    };\n\n} else if (parts[0] === \"confirm\" && parts[1] === \"yes\") {\n    // Подтверждение заказа\n    const dish = parts[2];\n    content = \"✅ Заказ оформлен: \" + dish + \"!\\nОжидайте доставку 🚀\";\n    keyboard = {\n        inline_keyboard: [\n            [{ text: \"⬅️ Назад в меню\", callback_data: \"back:menu\" }]\n        ]\n    };\n\n} else if (parts[0] === \"confirm\" && parts[1] === \"no\") {\n    // Отмена\n    content = \"Ок, заказ отменён.\";\n    keyboard = {\n        inline_keyboard: [\n            [{ text: \"🍽 В меню\", callback_data: \"back:menu\" }]\n        ]\n    };\n\n} else if (parts[0] === \"back\") {\n    // Возврат в меню\n    content = \"🍽 Меню ресторана\\n\\nВыберите блюдо:\";\n    keyboard = {\n        inline_keyboard: [\n            [{ text: \"🍕 Пицца\",  callback_data: \"order:pizza\" }],\n            [{ text: \"🍣 Суши\",   callback_data: \"order:sushi\" }],\n            [{ text: \"🍔 Бургер\", callback_data: \"order:burger\" }]\n        ]\n    };\n\n} else {\n    content = \"Неизвестное действие.\";\n    keyboard = null;\n}\n\nmsg.payload = {\n    chatId: chatId,\n    type: \"message\",\n    content: content,\n    options: {\n        reply_markup: keyboard\n    }\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
