    {
        "id": "2beff1e57072f472",
        "type": "function",
        "z": "cf20182d9e5c27fd",
        "name": "show menu",
        "func": "const chatId = msg.payload.chatId;\n\nmsg.payload = {\n    chatId: chatId,\n    type: \"message\",\n    content: \"🍽 Меню ресторана\\n\\nВыберите блюдо:\",\n    options: {\n        reply_markup: {\n            inline_keyboard: [\n                [{ text: \"🍕 Пицца\",  callback_data: \"order:pizza\" }],\n                [{ text: \"🍣 Суши\",   callback_data: \"order:sushi\" }],\n                [{ text: \"🍔 Бургер\", callback_data: \"order:burger\" }]\n            ]\n        }\n    }\n};\n\nreturn msg;",
        "outputs": 1,
