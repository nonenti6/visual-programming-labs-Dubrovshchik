        "z": "7a8d2f6a9d4e1607",
        "name": "counter",
        "func": "// Читаем текущее значение счётчика из flow context\n// Если его ещё нет — начинаем с 0\nlet counter = flow.get(\"counter\") || 0;\n\n// Увеличиваем\ncounter = counter + 1;\n\n// Записываем обратно\nflow.set(\"counter\", counter);\n\n// Формируем ответ\nmsg.payload = {\n    counter: counter,\n    message: \"Счётчик увеличился\",\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
