<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Carsharing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.28.0">
  <bpmn:collaboration id="Collaboration_Carsharing">
    <bpmn:participant id="Participant_Carsharing" name="Аренда автомобиля через каршеринговое приложение" processRef="Process_Carsharing" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Carsharing" name="Аренда автомобиля через каршеринговое приложение" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Client" name="Клиент">
        <bpmn:flowNodeRef>Task_Authorization</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Photo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_App</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EndRental</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_App" name="Мобильное приложение">
        <bpmn:flowNodeRef>Task_ShowCars</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Alternative</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Route</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Server" name="Сервер каршеринга">
        <bpmn:flowNodeRef>Task_CheckCar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Book</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CarAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Started</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CancelBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Price</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StartTrip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Parallel_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Parallel_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Telemetry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpenCar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0ta1u38</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1tcnnbu</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="Task_ShowCars" name="Показать карту с доступными авто">
      <bpmn:incoming>Flow_AuthOK_ShowCars</bpmn:incoming>
      <bpmn:outgoing>Flow_ShowCars_SelectCar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Photo" name="Фотофиксация состояния кузова">
      <bpmn:incoming>Flow_OpenCar_Photo</bpmn:incoming>
      <bpmn:outgoing>Flow_Photo_StartTrip</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Auth" name="Проверка пройдена?">
      <bpmn:incoming>Flow_Auth_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_AuthOK_ShowCars</bpmn:outgoing>
      <bpmn:outgoing>Flow_AuthFail_Return</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Start_Auth" sourceRef="StartEvent_App" targetRef="Task_Authorization" />
    <bpmn:sequenceFlow id="Flow_Auth_Gateway" sourceRef="Task_Authorization" targetRef="Gateway_Auth" />
    <bpmn:sequenceFlow id="Flow_AuthOK_ShowCars" name="Да" sourceRef="Gateway_Auth" targetRef="Task_ShowCars" />
    <bpmn:sequenceFlow id="Flow_AuthFail_Return" name="Нет" sourceRef="Gateway_Auth" targetRef="Task_Authorization" />
    <bpmn:sequenceFlow id="Flow_ShowCars_SelectCar" sourceRef="Task_ShowCars" targetRef="Task_SelectCar" />
    <bpmn:sequenceFlow id="Flow_SelectCar_CheckCar" sourceRef="Task_SelectCar" targetRef="Task_CheckCar" />
    <bpmn:sequenceFlow id="Flow_CarNo_Alternative" name="Нет" sourceRef="Gateway_CarAvailable" targetRef="Task_Alternative" />
    <bpmn:sequenceFlow id="Flow_Alternative_SelectCar" sourceRef="Task_Alternative" targetRef="Task_SelectCar" />
    <bpmn:sequenceFlow id="Flow_OpenCar_Photo" sourceRef="Task_OpenCar" targetRef="Task_Photo" />
    <bpmn:sequenceFlow id="Flow_Photo_StartTrip" sourceRef="Task_Photo" targetRef="Task_StartTrip" />
    <bpmn:sequenceFlow id="Flow_StartTrip_ParallelSplit" sourceRef="Task_StartTrip" targetRef="Gateway_Parallel_Split" />
    <bpmn:sequenceFlow id="Flow_ParallelSplit_Telemetry" sourceRef="Gateway_Parallel_Split" targetRef="Task_Telemetry" />
    <bpmn:sequenceFlow id="Flow_ParallelSplit_Price" sourceRef="Gateway_Parallel_Split" targetRef="Task_Price" />
    <bpmn:sequenceFlow id="Flow_ParallelSplit_Route" sourceRef="Gateway_Parallel_Split" targetRef="Task_Route" />
    <bpmn:sequenceFlow id="Flow_Telemetry_ParallelJoin" sourceRef="Task_Telemetry" targetRef="Gateway_Parallel_Join" />
    <bpmn:sequenceFlow id="Flow_Price_ParallelJoin" sourceRef="Task_Price" targetRef="Gateway_Parallel_Join" />
    <bpmn:sequenceFlow id="Flow_Route_ParallelJoin" sourceRef="Task_Route" targetRef="Gateway_Parallel_Join" />
    <bpmn:sequenceFlow id="Flow_ParallelJoin_EndRental" sourceRef="Gateway_Parallel_Join" targetRef="Task_EndRental" />
    <bpmn:task id="Task_SelectCar" name="Клиент выбирает автомобиль">
      <bpmn:incoming>Flow_ShowCars_SelectCar</bpmn:incoming>
      <bpmn:incoming>Flow_Alternative_SelectCar</bpmn:incoming>
      <bpmn:outgoing>Flow_SelectCar_CheckCar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="StartEvent_App" name="Запуск приложения">
      <bpmn:outgoing>Flow_Start_Auth</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Authorization" name="Авторизация с проверкой водительского удостоверения">
      <bpmn:incoming>Flow_Start_Auth</bpmn:incoming>
      <bpmn:incoming>Flow_AuthFail_Return</bpmn:incoming>
      <bpmn:outgoing>Flow_Auth_Gateway</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Alternative" name="Предложить альтернативный автомобиль">
      <bpmn:incoming>Flow_CarNo_Alternative</bpmn:incoming>
      <bpmn:outgoing>Flow_Alternative_SelectCar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Price" name="Рассчитывать стоимость по минутам">
      <bpmn:incoming>Flow_ParallelSplit_Price</bpmn:incoming>
      <bpmn:outgoing>Flow_Price_ParallelJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_StartTrip" name="Запустить двигатель и начать тарификацию">
      <bpmn:incoming>Flow_Photo_StartTrip</bpmn:incoming>
      <bpmn:outgoing>Flow_StartTrip_ParallelSplit</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Parallel_Split" name="Параллельно">
      <bpmn:incoming>Flow_StartTrip_ParallelSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_ParallelSplit_Telemetry</bpmn:outgoing>
      <bpmn:outgoing>Flow_ParallelSplit_Price</bpmn:outgoing>
      <bpmn:outgoing>Flow_ParallelSplit_Route</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="Gateway_Parallel_Join">
      <bpmn:incoming>Flow_Telemetry_ParallelJoin</bpmn:incoming>
      <bpmn:incoming>Flow_Price_ParallelJoin</bpmn:incoming>
      <bpmn:incoming>Flow_Route_ParallelJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_ParallelJoin_EndRental</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_Telemetry" name="Передавать телеметрию в диспетчерскую">
      <bpmn:incoming>Flow_ParallelSplit_Telemetry</bpmn:incoming>
      <bpmn:outgoing>Flow_Telemetry_ParallelJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Route" name="Строить маршрут и отслеживать зоны парковки">
      <bpmn:incoming>Flow_ParallelSplit_Route</bpmn:incoming>
      <bpmn:outgoing>Flow_Route_ParallelJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_EndRental" name="Завершить аренду">
      <bpmn:incoming>Flow_ParallelJoin_EndRental</bpmn:incoming>
      <bpmn:outgoing>Flow_1oe8j66</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_EndRental_Success" sourceRef="Activity_0ta1u38" targetRef="Activity_1tcnnbu" />
    <bpmn:sequenceFlow id="Flow_1oe8j66" sourceRef="Task_EndRental" targetRef="Activity_0ta1u38" />
    <bpmn:sequenceFlow id="Flow_StartedYes_OpenCar" name="Да" sourceRef="Gateway_Started" targetRef="Task_OpenCar" />
    <bpmn:sequenceFlow id="Flow_CheckCar_Gateway" sourceRef="Task_CheckCar" targetRef="Gateway_CarAvailable" />
    <bpmn:sequenceFlow id="Flow_CarYes_Book" name="Да" sourceRef="Gateway_CarAvailable" targetRef="Task_Book" />
    <bpmn:sequenceFlow id="Flow_Book_StartedGateway" sourceRef="Task_Book" targetRef="Gateway_Started" />
    <bpmn:sequenceFlow id="Flow_Cancel_Cancelled" sourceRef="Task_CancelBooking" targetRef="EndEvent_Cancelled" />
    <bpmn:sequenceFlow id="Flow_StartedNo_Cancel" name="Нет" sourceRef="Gateway_Started" targetRef="Task_CancelBooking" />
    <bpmn:endEvent id="EndEvent_Cancelled" name="Бронь снята">
      <bpmn:incoming>Flow_Cancel_Cancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_CheckCar" name="Проверить статус и исправность авто">
      <bpmn:incoming>Flow_SelectCar_CheckCar</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckCar_Gateway</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_CarAvailable" name="Автомобиль доступен?">
      <bpmn:incoming>Flow_CheckCar_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_CarYes_Book</bpmn:outgoing>
      <bpmn:outgoing>Flow_CarNo_Alternative</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Book" name="Забронировать авто на 15 минут">
      <bpmn:incoming>Flow_CarYes_Book</bpmn:incoming>
      <bpmn:outgoing>Flow_Book_StartedGateway</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Started" name="Поездка начата за 15 минут?">
      <bpmn:incoming>Flow_Book_StartedGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_StartedYes_OpenCar</bpmn:outgoing>
      <bpmn:outgoing>Flow_StartedNo_Cancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CancelBooking" name="Автоматически снять бронь">
      <bpmn:incoming>Flow_StartedNo_Cancel</bpmn:incoming>
      <bpmn:outgoing>Flow_Cancel_Cancelled</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_OpenCar" name="Открыть автомобиль (Bluetooth / QR)">
      <bpmn:incoming>Flow_StartedYes_OpenCar</bpmn:incoming>
      <bpmn:outgoing>Flow_OpenCar_Photo</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_0ta1u38" name="Закрыть двери">
      <bpmn:incoming>Flow_1oe8j66</bpmn:incoming>
      <bpmn:outgoing>Flow_EndRental_Success</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_0kcs6uj" sourceRef="Activity_1tcnnbu" targetRef="EndEvent_Success" />
    <bpmn:endEvent id="EndEvent_Success" name="Аренда завершена">
      <bpmn:incoming>Flow_0kcs6uj</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Activity_1tcnnbu" name="Сформировать чек и отправить клиенту">
      <bpmn:incoming>Flow_EndRental_Success</bpmn:incoming>
      <bpmn:outgoing>Flow_0kcs6uj</bpmn:outgoing>
    </bpmn:task>
  </bpmn:process>
